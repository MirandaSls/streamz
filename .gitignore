# dependencies
node_modules/
.pnpm-store/

# builds
dist/
.next/
out/
build/
apps/desktop/src-tauri/target/

# env
.env
.env.local
.env.*.local
# cópia de segurança do .env feita à mão no servidor: leva os segredos reais
.env.bak*
!.env.example

# config com segredo real do LiveKit (copiada de livekit.example.yaml em dev
# ou de livekit.prod.example.yaml no servidor)
livekit.yaml

# proxy de produção com os domínios reais (copiado de Caddyfile.example)
Caddyfile

# prisma
apps/api/prisma/*.db

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# turbo
.turbo/

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# TS build info
*.tsbuildinfo

# JS emitido por engano dentro de src/
packages/shared/src/*.js
packages/shared/src/*.js.map

# Next auto-gerado
apps/web/next-env.d.ts

# supressor de ruído copiado do node_modules pelo predev/prebuild
apps/web/public/supressor/

# Postgres embutido (pnpm db:embedded)
.pgdata/

# screenshots dos passeios ponta a ponta (scripts/e2e-*.mjs)
e2e-shots*/

# saída do graphify (grafo local do código, regenerável)
graphify-out/

# worktrees do Claude Code — cada uma carrega um node_modules inteiro
.claude/worktrees/

# Instaladores servidos por /api/downloads — binário de release não entra no
# repositório; a pasta é montada no contêiner como volume somente-leitura.
# A barra inicial ancora na raiz: sem ela o padrão engoliria também
# apps/api/src/modules/downloads/, que é código.
/downloads/
