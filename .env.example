# ── Banco de dados ───────────────────────────────────────────
# DEV (atual): SQLite, sem infra. O arquivo real fica em apps/api/.env
DATABASE_URL="file:./dev.db"
# PROD: trocar o provider no schema.prisma para "postgresql" e usar:
# DATABASE_URL="postgresql://newdisc:newdisc@localhost:5432/newdisc?schema=public"

# ── Auth (troque por segredos aleatórios longos) ─────────────
JWT_SECRET="troque-por-um-segredo-forte"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── LiveKit ──────────────────────────────────────────────────
# Opção A — Self-host via Docker (dev): `pnpm livekit:up`. As chaves precisam
# bater com ./livekit.yaml. Troque o secret por um aleatório longo (>= 32).
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="dev_secret_troque_isto_por_algo_aleatorio_32b"
#
# Opção B — LiveKit Cloud (https://cloud.livekit.io): comente A e use:
# LIVEKIT_URL="wss://SEU-PROJETO.livekit.cloud"
# LIVEKIT_API_KEY="API_xxxxxxxx"
# LIVEKIT_API_SECRET="secret_xxxxxxxxxxxxxxxxxxxx"

# ── Storage de anexos: Cloudflare R2 (compatível com S3) ─────
# Crie um bucket em dash.cloudflare.com → R2 e um API Token (S3).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="newdisc"
# Opcional: base pública do bucket (r2.dev ou domínio próprio). Sem ela, os
# anexos são servidos pelo proxy da API em /api/uploads/file/:id.
R2_PUBLIC_BASE_URL=""
# Base pública da API, usada para montar a URL do proxy de anexos.
API_PUBLIC_URL="http://localhost:3333"

# ── API ──────────────────────────────────────────────────────
API_PORT="3333"
CORS_ORIGIN="http://localhost:3000"

# ── Web (expostas ao browser) ────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3333"
NEXT_PUBLIC_WS_URL="http://localhost:3333"
# Self-host (Opção A): ws://localhost:7880 · Cloud (Opção B): wss://SEU-PROJETO.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"
