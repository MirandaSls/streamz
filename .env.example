# ── Banco de dados ───────────────────────────────────────────
# PostgreSQL em dev e em prod (banco único). Em dev: `pnpm db:up` sobe o
# Postgres do docker-compose com estas credenciais e só em 127.0.0.1.
# Para trocá-las, defina POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB antes do
# `docker compose` e reflita aqui. Depois: `pnpm db:migrate`.
DATABASE_URL="postgresql://streamz:streamz@localhost:5432/streamz?schema=public"

# ── Auth (troque por segredos aleatórios longos) ─────────────
JWT_SECRET="troque-por-um-segredo-forte"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── E-mail transacional (verificação de conta, redefinir senha) ─
# OPCIONAL. Sem SMTP_URL o provedor é `console`: a API imprime o assunto e o
# link no próprio log, e o fluxo inteiro (registrar → clicar → verificar) roda
# sem servidor de e-mail. Em produção (NODE_ENV=production) a ausência de SMTP
# faz as rotas que dependem de e-mail responderem 503.
SMTP_URL=""
SMTP_FROM="Streamz <nao-responda@streamz.local>"
# Base pública da **web** (não da API): é para lá que apontam os links do e-mail.
WEB_PUBLIC_URL="http://localhost:3000"

# ── LiveKit ──────────────────────────────────────────────────
# Opção A — Self-host via Docker (dev): `cp livekit.example.yaml livekit.yaml`,
# gere o secret com `openssl rand -hex 32` e cole o MESMO valor nos dois lugares
# (`keys:` do livekit.yaml e LIVEKIT_API_SECRET aqui). Depois `pnpm livekit:up`.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="TROQUE_POR_UM_SECRET_ALEATORIO_openssl_rand_hex_32"
#
# Opção B — LiveKit Cloud (https://cloud.livekit.io): comente A e use:
# LIVEKIT_URL="wss://SEU-PROJETO.livekit.cloud"
# LIVEKIT_API_KEY="API_xxxxxxxx"
# LIVEKIT_API_SECRET="secret_xxxxxxxxxxxxxxxxxxxx"

# ── Storage de anexos: Cloudflare R2 (compatível com S3) ─────
# Crie um bucket em dash.cloudflare.com → R2 e um API Token (S3).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="streamz"
# Opcional: base pública do bucket (r2.dev ou domínio próprio). Só preencha se o
# bucket for mesmo público — sem ela a API devolve URL assinada com expiração, e
# cai no proxy autenticado /api/uploads/file/:id quando não dá para assinar.
R2_PUBLIC_BASE_URL=""
# Base pública da API, usada para montar a URL do proxy de anexos.
# JWT_SECRET e JWT_REFRESH_SECRET são obrigatórios, precisam de >= 16 caracteres
# e têm de ser diferentes entre si — a API não sobe fora disso.
API_PUBLIC_URL="http://localhost:3333"

# ── GIFs (Tenor v2) ──────────────────────────────────────────
# Opcional: sem a chave, as rotas de GIF respondem `configured: false` e o
# seletor do composer mostra "GIFs não configurados". Chave gratuita em
# https://developers.google.com/tenor/guides/quickstart
TENOR_API_KEY=""

# ── API ──────────────────────────────────────────────────────
API_PORT="3333"
CORS_ORIGIN="http://localhost:3000"
# Interface em que a API escuta. 0.0.0.0 é obrigatório dentro de contêiner
# (preso ao loopback, o mapeamento de porta do Docker não alcança o processo).
API_HOST="0.0.0.0"
# "json" (uma linha JSON por evento, para agregador) ou "pretty"/"text"
# (legível no terminal). Vazio = json em produção, pretty fora dela.
LOG_FORMAT=""
# Nível mínimo de log: trace|debug|info|warn|error. Vazio = info em produção,
# debug fora dela.
LOG_LEVEL=""
# Versão exposta em GET /api/health (útil para saber qual build está no ar).
# Em deploy, preencha com a tag ou o SHA do commit. Vazio = "dev".
APP_VERSION=""
# Confiança no X-Forwarded-For, para o rate limit ver o IP real do cliente:
# número de proxies à frente ("1"), lista de IPs/CIDRs, ou "true"/"false".
# Deixe vazio sem proxy na frente — senão qualquer cliente forja o próprio IP.
TRUST_PROXY=""
# "1" faz o entrypoint da imagem rodar `prisma migrate deploy` antes de subir.
# Ligue só onde há uma instância só (docker compose, job de release).
RUN_MIGRATIONS="0"

# ── Redis (opcional) ─────────────────────────────────────────
# Só necessário para rodar a API em mais de uma instância: compartilha
# broadcast do Socket.IO, presença e rate limit. Vazio = tudo em memória do
# processo. No docker compose: `--profile redis` e redis://redis:6379.
REDIS_URL=""

# ── Web (expostas ao browser) ────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3333"
NEXT_PUBLIC_WS_URL="http://localhost:3333"
# Self-host (Opção A): ws://localhost:7880 · Cloud (Opção B): wss://SEU-PROJETO.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"
