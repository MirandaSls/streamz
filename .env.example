# ── Banco de dados ───────────────────────────────────────────
# DEV (atual): SQLite, sem infra. O arquivo real fica em apps/api/.env
DATABASE_URL="file:./dev.db"
# PROD: trocar o provider no schema.prisma para "postgresql" e usar:
# DATABASE_URL="postgresql://newdisc:newdisc@localhost:5432/newdisc?schema=public"

# ── Auth (troque por segredos aleatórios longos) ─────────────
JWT_SECRET="troque-por-um-segredo-forte"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── LiveKit Cloud (crie em https://cloud.livekit.io) ─────────
LIVEKIT_URL="wss://SEU-PROJETO.livekit.cloud"
LIVEKIT_API_KEY="API_xxxxxxxx"
LIVEKIT_API_SECRET="secret_xxxxxxxxxxxxxxxxxxxx"

# ── API ──────────────────────────────────────────────────────
API_PORT="3333"
CORS_ORIGIN="http://localhost:3000"

# ── Web (expostas ao browser) ────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3333"
NEXT_PUBLIC_WS_URL="http://localhost:3333"
NEXT_PUBLIC_LIVEKIT_URL="wss://SEU-PROJETO.livekit.cloud"
