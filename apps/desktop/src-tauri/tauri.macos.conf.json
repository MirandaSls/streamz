{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Streamz",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 9, "y": 14 },
        "visible": false,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "splash",
        "url": "splash/",
        "title": "Streamz",
        "width": 300,
        "height": 350,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#1A1A1E",
        "shadow": false,
        "visible": false,
        "focus": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.macos.plist",
      "infoPlist": "./Info.macos.plist"
    }
  }
}
