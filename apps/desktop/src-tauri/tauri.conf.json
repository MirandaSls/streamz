{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streamz",
  "version": "1.3.5",
  "identifier": "dev.streamz.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @streamz/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @streamz/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Streamz",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "splash",
        "url": "splash/",
        "title": "Streamz",
        "width": 300,
        "height": 350,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "object-src": "'none'",
        "frame-src": "https://www.youtube-nocookie.com",
        "form-action": "'none'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https: http://localhost:3333",
        "media-src": "'self' data: blob: mediastream: https: http://localhost:3333",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3333 ws://localhost:3333 ws://localhost:7880 https://api.streamz.chat wss://api.streamz.chat wss://livekit.streamz.chat https://*.livekit.cloud wss://*.livekit.cloud https://*.r2.cloudflarestorage.com https://*.r2.dev https://media.giphy.com https://i.giphy.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Streamz",
    "category": "SocialNetworking",
    "shortDescription": "Chat em servidores/canais em tempo real",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.streamz.chat/api/updates/{{target}}/{{arch}}/{{current_version}}?bundle_type={{bundle_type}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNjczOThFNERENUNCQUEKUldTcXk5Vk5qamxuSHBweUdZdVNwUzFpd1Bld3hwVklQNVVnVkdBZFZwN0QrYzBtWEJhYkNpaHYK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
