{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NewDisc",
  "version": "0.0.1",
  "identifier": "dev.newdisc.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @newdisc/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @newdisc/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NewDisc",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: http://localhost:3333",
        "media-src": "'self' data: blob: mediastream:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3333 ws://localhost:3333 ws://localhost:7880 https://*.livekit.cloud wss://*.livekit.cloud"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "NewDisc",
    "category": "SocialNetworking",
    "shortDescription": "Chat em servidores/canais em tempo real",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["PortugueseBR", "English"]
      }
    }
  },
  "plugins": {}
}
