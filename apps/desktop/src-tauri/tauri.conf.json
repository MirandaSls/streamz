{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streamz",
  "version": "0.0.1",
  "identifier": "dev.streamz.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @streamz/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @streamz/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Streamz",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "object-src": "'none'",
        "frame-src": "https://www.youtube-nocookie.com",
        "form-action": "'none'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https: http://localhost:3333",
        "media-src": "'self' data: blob: mediastream: https: http://localhost:3333",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3333 ws://localhost:3333 ws://localhost:7880 https://api.streamz.chat wss://api.streamz.chat wss://livekit.streamz.chat https://*.livekit.cloud wss://*.livekit.cloud"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Streamz",
    "category": "SocialNetworking",
    "shortDescription": "Chat em servidores/canais em tempo real",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      }
    }
  },
  "plugins": {}
}
