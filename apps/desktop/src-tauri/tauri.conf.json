{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NewDisc",
  "version": "0.0.1",
  "identifier": "dev.newdisc.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @newdisc/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @newdisc/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NewDisc",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "NewDisc",
    "category": "SocialNetworking",
    "shortDescription": "Chat em servidores/canais em tempo real",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["PortugueseBR", "English"]
      }
    }
  },
  "plugins": {}
}
