// Prisma schema — Streamz
//
// Banco único: **PostgreSQL**, em dev e em produção. Não há mais variante
// SQLite — os enums (`UserStatus`, `ChannelType`, `MemberRole`) são garantidos
// pelo banco, e `packages/shared` expõe as mesmas unions para o contrato.
//
// Fluxo: `pnpm db:up` (Postgres do docker-compose) → `pnpm db:migrate`
// (migrate dev, cria/aplica migration) ou `pnpm db:deploy` em produção.
// `prisma db push` NÃO é o fluxo: toda mudança de modelo vira migration.
//
// ── j-bots ── a coluna `snowflake`
//
// Nove tabelas (User, Guild, Channel, Category, Message, Role, CustomEmoji,
// Attachment, Sticker) têm, além do `id` cuid, um `snowflake BIGINT UNIQUE`
// gerado pelo banco (função `streamz_snowflake()`, migration `..._snowflakes`).
// É o id que as bibliotecas de bot do Discord exigem — elas derivam a data de
// criação dele. O cuid **não** foi migrado e continua sendo a chave: o
// snowflake é uma segunda identidade, só para a casca de compatibilidade. Ver
// `docs/BOTS-COMPATIVEIS-COM-O-DISCORD.md` §4 (decisão D1).
//
// Cuidado ao ler essas tabelas: `BigInt` do Prisma vira `bigint` do JS, e
// `JSON.stringify` de um `bigint` lança `TypeError`. Nunca devolva a linha crua
// numa resposta HTTP nem num `emit` — passe pelos conversores de
// `src/common/dto.ts`, que montam o DTO campo a campo.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

// TEXT/VOICE: canal de servidor. DM/GROUP: conversa sem servidor (guildId null),
// cujo acesso é ser participante (ChannelMember). Ver docs/adr/0001.
enum ChannelType {
  TEXT
  VOICE
  DM
  GROUP
  ANNOUNCEMENT
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id                    String      @id @default(cuid())
  snowflake             BigInt      @unique @default(dbgenerated("streamz_snowflake()"))
  username              String      @unique
  passwordHash          String
  // nome de exibição (o Discord separa "display name" de "username")
  displayName           String?
  avatarUrl             String?
  // chave do objeto do avatar no storage; a URL pública é derivada na hora
  avatarKey             String?
  // presença efetiva, mantida pelo gateway (ONLINE/OFFLINE conforme conexões)
  status                UserStatus  @default(OFFLINE)
  // status escolhido pelo usuário (Ausente, Não perturbe, Invisível=OFFLINE);
  // null = automático. Só vale enquanto ele está conectado.
  manualStatus          UserStatus?
  createdAt             DateTime    @default(now())
  // ── d-social ──
  // Status personalizado: texto + emoji + quando deixa de valer (null = nunca).
  // A faxina do MaintenanceService zera os vencidos; a leitura também trata o
  // vencido como ausente, para não depender do horário do job.
  customStatusText      String?
  customStatusEmoji     String?
  customStatusExpiresAt DateTime?
  // Perfil rico: "sobre mim", pronomes e a faixa do cartão (cor ou imagem).
  aboutMe               String?
  pronouns              String?
  bannerColor           String?
  bannerKey             String?
  // Última desconexão — "visto por último" no perfil. O gateway grava no
  // disconnect; enquanto o usuário está online o valor é o da sessão anterior.
  lastSeenAt            DateTime?

  ownedGuilds      Guild[]         @relation("GuildOwner")
  memberships      GuildMember[]
  messages         Message[]
  reactions        Reaction[]
  invites          Invite[]        @relation("InviteCreator")
  bans             Ban[]           @relation("BannedUser")
  ownedChannels    Channel[]       @relation("ChannelOwner")
  refreshTokens    RefreshToken[]
  channelAccess    ChannelMember[]
  attachments      Attachment[]    @relation("AttachmentUploader")
  readStates       ReadState[]
  // ── c-cargos ──
  memberRoles      GuildMemberRole[]
  channelOverrides ChannelOverride[]
  categoryOverrides CategoryOverride[]
  // ── a-mensagens ──
  pinnedMessages   PinnedMessage[] @relation("PinAuthor")
  createdThreads   Thread[]        @relation("ThreadCreator")
  // ── e-configuracoes ──
  notificationSettings NotificationSetting[]
  // ── d-social ──
  friendshipsSent     Friendship[]    @relation("FriendshipRequester")
  friendshipsReceived Friendship[]    @relation("FriendshipAddressee")
  blocksMade          Block[]         @relation("Blocker")
  blocksReceived      Block[]         @relation("Blocked")
  hiddenChannels      DMHidden[]
  // ── g-emojis-midia ──
  customEmojis     CustomEmoji[]   @relation("EmojiCreator")
  createdStickers  Sticker[]       @relation("StickerCreator")
  createdSounds    SoundboardSound[] @relation("SoundboardCreator")
  // ── h-moderacao ──
  auditLogs       AuditLog[] @relation("AuditActor")
  pollVotes       PollVote[]
  reportsMade     Report[]   @relation("ReportReporter")
  reportsResolved Report[]   @relation("ReportResolver")

  // ── i-conta ── e-mail, 2FA, bloqueio por força bruta e fim de vida da conta
  // nullable porque contas criadas antes de o e-mail existir seguem válidas
  email           String?   @unique
  emailVerifiedAt DateTime?
  // segredo TOTP em base32; só vira 2FA de fato quando mfaEnabledAt existe
  mfaSecret       String?
  mfaEnabledAt    DateTime?
  // bloqueio progressivo por conta: 5 falhas seguidas trancam por 15 min
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  // conta desativada pelo dono: bloqueia o login até ele reativar entrando
  disabledAt      DateTime?
  // conta excluída: anonimizada, sem volta. As mensagens ficam (como no Discord)
  deletedAt       DateTime?

  emailTokens   EmailToken[]
  recoveryCodes MfaRecoveryCode[]
  oauthAccounts OAuthAccount[]

  // ── j-bots ──
  // Conta de bot: não faz login, não recebe e-mail, aparece com a tag BOT.
  // A senha é um hash de bytes aleatórios que ninguém conhece — a coluna é
  // obrigatória e não há "sem senha" no esquema.
  isBot          Boolean       @default(false)
  /// a application de que este usuário é o bot (só quando isBot)
  botApplication Application?  @relation("AppBot")
  ownedApps      Application[] @relation("AppOwner")
}

// Até onde cada usuário leu cada canal. É o que decide "não lido" e o badge
// de menções: mensagem com createdAt > lastReadAt (e que não é do próprio
// usuário) conta como nova. Sem linha = nunca abriu o canal.
model ReadState {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
}

// Um registro por refresh token emitido. Rotação: a cada /auth/refresh o token
// apresentado é marcado como revogado e um novo é emitido. Logout revoga.
// Guardamos só o hash do jti — nunca o token em si.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // ── i-conta ── um refresh token vivo *é* uma sessão na tela "Dispositivos";
  // sem estes campos ela não teria o que mostrar além da data.
  userAgent  String?
  ip         String?
  lastUsedAt DateTime?
  // O `User-Agent` do app de desktop é o do Edge (Tauri 2 = WebView2), então
  // ele não separa "app instalado" de "aba do navegador". Quem separa é o
  // cabeçalho `X-Streamz-Client`, que só existe na requisição — por isso o tipo
  // é classificado no login/refresh e **guardado**: "desktop" | "navegador" |
  // "celular" | "desconhecido". Null = sessão anterior à coluna (a tela cai no
  // palpite pelo `User-Agent` até o próximo refresh).
  dispositivo String?
}

model Guild {
  id      String  @id @default(cuid())
  snowflake BigInt      @unique @default(dbgenerated("streamz_snowflake()"))
  name    String
  iconUrl String?
  ownerId String
  owner   User    @relation("GuildOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  members  GuildMember[]
  channels Channel[]
  invites  Invite[]
  bans     Ban[]
  // ── c-cargos ──
  description String?
  // Cor da faixa do perfil do servidor (`#rrggbb`), o topo do degradê.
  // null = sem faixa. É dado do servidor, escolhido em Configurações →
  // Perfil do servidor; a tabela de degradês vive em `GUILD_BANNER_COLORS`.
  bannerColor String?
  // chave do objeto do ícone no storage; a URL é derivada na hora
  iconKey     String?
  roles       Role[]
  memberRoles GuildMemberRole[]
  // ── b-canais ──
  categories Category[]
  notificationSettings NotificationSetting[]
  customEmojis CustomEmoji[] @relation("GuildEmojis")
  stickers     Sticker[]     @relation("GuildStickers")
  soundboard   SoundboardSound[] @relation("GuildSoundboard")

  // ── h-moderacao ──
  // Canal onde entram as mensagens "X entrou no servidor"; null = desligado.
  systemChannelId    String?
  // Canal de regras. Quando existe, postar exige aceite (GuildMember.acceptedRulesAt).
  rulesChannelId     String?
  welcomeDescription String?
  // Canais em destaque da tela de boas-vindas, na ordem escolhida.
  welcomeChannelIds  String[]   @default([])
  // Aparece em "Descobrir" (GET /discover).
  discoverable       Boolean    @default(false)
  auditLogs          AuditLog[]
  reports            Report[]
}

model Ban {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  bannedById String
  reason     String?
  createdAt  DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  guildId   String
  creatorId String
  uses      Int       @default(0)
  maxUses   Int?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  guild   Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator User  @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  // ── h-moderacao ──
  // Convite temporário: o convidado sai do servidor ao desconectar.
  temporary Boolean  @default(false)
  // Canal para onde o convite leva; null = canal de sistema ou o primeiro.
  channelId String?
  channel   Channel? @relation("InviteChannel", fields: [channelId], references: [id], onDelete: SetNull)

  @@index([guildId])
}

model GuildMember {
  id      String     @id @default(cuid())
  userId  String
  guildId String
  role    MemberRole @default(MEMBER)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  // ── h-moderacao ──
  // Fim do castigo. Data no passado = sem castigo (o histórico não é apagado).
  timeoutUntil    DateTime?
  // Quando aceitou as regras do servidor; null = ainda não aceitou.
  acceptedRulesAt DateTime?
  // Quando viu a tela de boas-vindas; null = mostrar ao abrir o servidor.
  welcomeSeenAt   DateTime?

  @@unique([userId, guildId])
  @@index([guildId])
}

// Um canal é qualquer lugar onde mensagens vivem — canal de servidor (TEXT/VOICE)
// ou conversa direta (DM/GROUP). Uma tabela só para que toda feature de mensagem
// (reação, anexo, thread, busca) valha nos dois casos por construção (ADR-0001).
model Channel {
  id        String      @id @default(cuid())
  snowflake BigInt      @unique @default(dbgenerated("streamz_snowflake()"))
  // null em DM/GROUP: a conversa não pertence a servidor nenhum. Toda query de
  // servidor precisa partir de um guildId concreto — nunca "todos os canais".
  guildId   String?
  // null em DM (o título é derivado dos participantes); opcional em GROUP.
  name      String?
  type      ChannelType @default(TEXT)
  position  Int         @default(0)
  private   Boolean     @default(false) // só OWNER/ADMIN e a allowlist enxergam
  readOnly  Boolean     @default(false) // só OWNER/ADMIN postam; todos leem
  // criador do grupo; null em DM e em canal de servidor.
  ownerId   String?
  // chave canônica "a:b" (ids ordenados) só em DM 1-a-1 — garante 1 canal por
  // dupla via upsert atômico. NULLs múltiplos são permitidos no Postgres.
  pairKey   String?     @unique
  createdAt DateTime    @default(now())
  // ── d-social ── chave do ícone do grupo no storage (null em DM 1-a-1)
  iconKey   String?

  guild      Guild?          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  owner      User?           @relation("ChannelOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  messages   Message[]
  members    ChannelMember[]
  readStates ReadState[]
  // ── c-cargos ──
  overrides  ChannelOverride[]

  // ── b-canais ──
  // agrupamento visual da barra lateral; null = canal solto, no topo da lista
  categoryId      String?
  // descrição curta mostrada no cabeçalho do canal
  topic           String?
  // intervalo mínimo entre mensagens do mesmo autor (0 = desligado)
  slowmodeSeconds Int      @default(0)
  // conteúdo sensível: o cliente pede confirmação antes de abrir
  nsfw            Boolean  @default(false)
  // "sincronizado" (Discord): as permissões deste canal são as da categoria.
  // Enquanto é true, editar a categoria reescreve os ChannelOverride do canal;
  // a primeira edição feita NO canal copia as regras da categoria e desliga
  // isto — daí em diante o canal anda sozinho. Falso para canal sem categoria.
  syncedWithCategory Boolean @default(false)
  // apagar a categoria não apaga os canais — eles voltam a ficar sem categoria
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // ── a-mensagens ──
  pins       PinnedMessage[]
  threads    Thread[]
  notificationSettings NotificationSetting[]
  // ── d-social ──
  hiddenBy   DMHidden[]

  // ── h-moderacao ──
  channelInvites Invite[] @relation("InviteChannel")
  reports        Report[]

  @@index([guildId])
  @@index([categoryId])
}

// Duas leituras, mesma tabela: em canal de servidor privado é a allowlist de
// quem enxerga (além de OWNER/ADMIN, sempre com acesso); em DM/GROUP é a lista
// de participantes. Nos dois casos responde "este usuário tem acesso a este
// canal?".
model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId]) // "minhas conversas"
}

model Message {
  id        String      @id @default(cuid())
  snowflake BigInt      @unique @default(dbgenerated("streamz_snowflake()"))
  channelId String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime    @default(now())
  editedAt  DateTime?
  // DEFAULT = escrita por alguém; SYSTEM_* = narração (fixar, entrada de
  // membro, eventos de grupo de DM) — ver packages/shared.
  type      MessageType @default(DEFAULT)

  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions   Reaction[]
  attachments Attachment[]

  // thread: uma mensagem-raiz (parentId null) agrupa respostas
  parent  Message?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Message[] @relation("MessageThread")

  // ── a-mensagens ──
  // resposta (reply do Discord): aponta para a mensagem citada, que pode estar
  // em qualquer ponto do mesmo canal — não é o mesmo que `parentId` (thread).
  replyToId    String?
  // "@ ligado": a resposta menciona o autor da original e conta como menção.
  replyMention Boolean     @default(false)
  // SetNull, não Cascade: apagar a original não pode levar junto quem respondeu.
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  repliedBy Message[] @relation("MessageReply")
  pin       PinnedMessage?
  thread    Thread?
  // ── h-moderacao ──
  poll       Poll?
  reports    Report[]

  @@index([channelId, parentId, createdAt])
  @@index([parentId])
  @@index([replyToId])
  // g-emojis-midia: mensagem só de figurinha e "remover prévia" do link
  stickerId      String?
  suppressEmbeds Boolean  @default(false)
  sticker        Sticker? @relation(fields: [stickerId], references: [id], onDelete: SetNull)
}

// Arquivo enviado ao storage (R2). Criado no upload (messageId null) e
// vinculado a uma mensagem no envio. Órfãos (nunca vinculados) são apagados
// pela faxina diária do MaintenanceService, no bucket e aqui. O objeto no
// bucket vive na chave `key`.
model Attachment {
  id          String   @id @default(cuid())
  snowflake   BigInt      @unique @default(dbgenerated("streamz_snowflake()"))
  messageId   String?
  uploaderId  String
  key         String   @unique
  filename    String
  contentType String
  size        Int
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User     @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId])
  // g-emojis-midia: GIF enviado por URL do provedor — sem objeto no bucket.
  // `key` continua obrigatória e única; nesse caso é um marcador sintético.
  externalUrl String?
}

model Reaction {
  id        String @id @default(cuid())
  messageId String
  userId    String
  emoji     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ── c-cargos ──────────────────────────────────────────────────
// Cargos, atribuições e regras por canal. A permissão efetiva é calculada por
// `computePermissions` (@streamz/shared) — ver docs/adr/0002.

// Um cargo do servidor. `permissions` é o bitfield de `Permission`; os bits são
// estáveis para sempre, porque o valor fica gravado aqui.
model Role {
  id          String   @id @default(cuid())
  snowflake   BigInt      @unique @default(dbgenerated("streamz_snowflake()"))
  guildId     String
  name        String
  // "#rrggbb"; null = sem cor (o nome herda a cor padrão do tema)
  color       String?
  // hierarquia: maior = mais alto. O @everyone é sempre 0.
  position    Int      @default(1)
  permissions Int      @default(0)
  // exibe os membros deste cargo numa seção própria da lista de membros
  hoist       Boolean  @default(false)
  mentionable Boolean  @default(false)
  // o @everyone, criado com o servidor: não se apaga nem se atribui
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  guild     Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  members   GuildMemberRole[]
  overrides ChannelOverride[]
  categoryOverrides CategoryOverride[]

  @@index([guildId])
}

// N:N entre membro e cargo. Chama-se GuildMemberRole (e não MemberRole) porque
// MemberRole já é o nome do enum de papel — modelo e enum não coexistem com o
// mesmo nome. O @everyone NÃO gera linha aqui: vale para todo membro por
// definição, e materializá-lo só criaria estado para manter sincronizado.
model GuildMemberRole {
  id      String @id @default(cuid())
  guildId String
  userId  String
  roleId  String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([guildId, userId])
  @@index([roleId])
}

// Regra de um canal para um cargo OU um usuário (nunca os dois). É a fonte da
// verdade de canal privado (deny VIEW_CHANNEL no @everyone) e somente-leitura
// (deny SEND_MESSAGES no @everyone); `Channel.private`/`readOnly` são espelho.
model ChannelOverride {
  id        String @id @default(cuid())
  channelId String
  roleId    String?
  userId    String?
  allow     Int    @default(0)
  deny      Int    @default(0)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, roleId])
  @@unique([channelId, userId])
  @@index([channelId])
}

// ── b-canais ──
// Categoria: agrupamento de canais na barra lateral de um servidor. Não
// autoriza nada (quem decide acesso continua sendo GuildsService) e não muda
// rota nenhuma — é ordem e rótulo. Apagá-la solta os canais (`SetNull`) em vez
// de levá-los junto, que é o comportamento do Discord.
model Category {
  id        String   @id @default(cuid())
  snowflake BigInt      @unique @default(dbgenerated("streamz_snowflake()"))
  guildId   String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  guild    Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channels Channel[]
  // ── c-cargos ──
  overrides CategoryOverride[]

  @@index([guildId])
}

// Regra de uma CATEGORIA para um cargo OU um usuário (nunca os dois). Mesma
// forma do ChannelOverride: é a fonte da verdade de "categoria privada" e o
// molde que os canais sincronizados (`Channel.syncedWithCategory`) copiam.
// Tabela separada, e não um `categoryId` nullable no ChannelOverride, porque
// as unicidades ("uma regra por cargo por canal") são por dono e um NULL a
// mais as tornaria inexprimíveis no Postgres.
model CategoryOverride {
  id         String @id @default(cuid())
  categoryId String
  roleId     String?
  userId     String?
  allow      Int    @default(0)
  deny       Int    @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  role     Role?    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([categoryId, roleId])
  @@unique([categoryId, userId])
  @@index([categoryId])
}

// ── a-mensagens ──────────────────────────────────────────────

// Tipo da mensagem. `DEFAULT` é a mensagem escrita por alguém; as `SYSTEM_*`
// são narração renderizada como linha discreta, sem avatar nem ações: fixar
// (a-mensagens), entrada de membro (moderação) e os eventos de grupo de DM
// (d-social). O autor é sempre quem fez a ação; o `content` guarda o alvo ou o
// valor novo. Enum único — a equivalência com `MessageType` de @streamz/shared
// é travada em common/enums.ts.
enum MessageType {
  DEFAULT
  SYSTEM_PIN
  SYSTEM_JOIN
  SYSTEM_MEMBER_ADDED
  SYSTEM_MEMBER_REMOVED
  SYSTEM_MEMBER_LEFT
  SYSTEM_GROUP_RENAMED
  SYSTEM_GROUP_ICON
  SYSTEM_MOD_NOTICE
}

// Mensagem fixada no canal. `messageId` é único: fixar duas vezes é idempotente,
// e a lista do canal sai daqui em vez de uma coluna booleana na mensagem (assim
// sabemos quem fixou e quando, que é o que a mensagem de sistema narra).
model PinnedMessage {
  id         String   @id @default(cuid())
  channelId  String
  messageId  String   @unique
  pinnedById String
  pinnedAt   DateTime @default(now())

  channel  Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User    @relation("PinAuthor", fields: [pinnedById], references: [id], onDelete: Cascade)

  @@index([channelId, pinnedAt])
}

// Thread nomeada: o *nome* de uma raiz que já agrupa respostas por `parentId`.
// O id é o id da mensagem raiz — uma raiz tem no máximo uma thread, e raiz sem
// linha aqui continua sendo thread sem nome (compatibilidade com o que existia).
model Thread {
  id          String   @id
  channelId   String
  name        String
  archived    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  root      Message @relation(fields: [id], references: [id], onDelete: Cascade)
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ThreadCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([channelId, archived])
}

// ── e-configuracoes ──────────────────────────────────────────

// Quanto um escopo notifica. Mesmos literais da union `NotificationLevel` de
// @streamz/shared — a equivalência é travada em common/enums.ts.
enum NotificationLevel {
  ALL
  MENTIONS
  NONE
}

// Preferência de notificação de um usuário para um escopo: um canal, um
// servidor, ou o padrão global (scope "global").
//
// `scope` é uma coluna canônica ("global" | "guild:<id>" | "channel:<id>")
// porque no Postgres NULLs são distintos entre si: um @@unique sobre
// (userId, guildId, channelId) deixaria gravar duas linhas do mesmo escopo.
// `muted` é independente de `level` (silenciar não apaga "só menções" por
// baixo) e `mutedUntil` null com `muted` true é "até eu reativar".
model NotificationSetting {
  id         String            @id @default(cuid())
  userId     String
  scope      String
  guildId    String?
  channelId  String?
  level      NotificationLevel @default(ALL)
  muted      Boolean           @default(false)
  mutedUntil DateTime?
  updatedAt  DateTime          @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild   Guild?   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, scope])
  @@index([userId])
}

// ── d-social ──────────────────────────────────────────────────

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Amizade e pedido de amizade na mesma linha: PENDING é o pedido de
// `requester` para `addressee`, ACCEPTED é a amizade (que não tem direção).
// Uma linha só evita o estado impossível "A é amigo de B mas B não é de A".
// A unicidade do par é garantida por `pairKey` ("menor:maior"), porque o
// @@unique([requesterId, addresseeId]) sozinho deixaria os dois lados pedirem.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  pairKey     String           @unique
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([addresseeId])
}

// Bloqueio: direcional (A bloqueia B sem que B saiba). Bloquear derruba a
// amizade e o pedido pendente; o bloqueado não abre DM nem manda pedido.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Conversa "fechada" por um usuário: some da lista dele até chegar mensagem
// nova. Guardar o instante (e não um booleano) é o que faz a conversa
// reaparecer sozinha — a lista compara `hiddenAt` com a última mensagem, sem
// depender de ninguém apagar a linha no envio.
model DMHidden {
  userId    String
  channelId String
  hiddenAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
}

// ── g-emojis-midia ──────────────────────────────────────────
// Emoji personalizado de um servidor. O arquivo vive no storage (chave `key`);
// a leitura é pela rota `GET /emojis/:id/image`, que serve os bytes — emoji
// aparece em mensagem de qualquer canal, inclusive para quem já não vê o
// servidor de origem, então não faz sentido amarrar a URL à autorização do
// canal (é o mesmo que o Discord faz com o CDN de emoji).
model CustomEmoji {
  id          String   @id @default(cuid())
  snowflake   BigInt      @unique @default(dbgenerated("streamz_snowflake()"))
  guildId     String
  // sem os dois-pontos: `festa` em `:festa:`. Único dentro do servidor.
  name        String
  key         String   @unique
  contentType String
  size        Int
  // GIF: o seletor sinaliza e o render não precisa fazer nada diferente
  animated    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  guild     Guild @relation("GuildEmojis", fields: [guildId], references: [id], onDelete: Cascade)
  createdBy User  @relation("EmojiCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@index([guildId])
}

// Figurinha de um servidor — imagem grande enviada no lugar do texto. Mesma
// mecânica de storage do emoji; `tags` são as palavras que a busca do seletor
// consulta além do nome.
model Sticker {
  id          String   @id @default(cuid())
  snowflake   BigInt      @unique @default(dbgenerated("streamz_snowflake()"))
  guildId     String
  name        String
  tags        String   @default("")
  key         String   @unique
  contentType String
  size        Int
  createdById String
  createdAt   DateTime @default(now())

  guild     Guild     @relation("GuildStickers", fields: [guildId], references: [id], onDelete: Cascade)
  createdBy User      @relation("StickerCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([guildId, name])
  @@index([guildId])
}

// Som do painel de efeitos sonoros de um servidor. Mesma mecânica de storage do
// emoji e da figurinha (objeto no bucket, `key` única, permissão MANAGE_EMOJIS);
// o que muda é o `volume`, um fator de referência do próprio som — os arquivos
// chegam masterizados em níveis diferentes e sem ele um "airhorn" sai três
// vezes mais alto que um "golf clap" no mesmo volume de efeitos.
//
// O nome **não** é único no servidor: dois "airhorn" enviados por pessoas
// diferentes são dois sons, e recusar o segundo por causa do rótulo obrigaria a
// renomear algo que ninguém digita em lugar nenhum (ao contrário de `:nome:`).
model SoundboardSound {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  // emoji do card; vazio quando não tem
  emoji       String   @default("")
  key         String   @unique
  contentType String
  size        Int
  volume      Float    @default(1)
  createdById String
  createdAt   DateTime @default(now())

  guild     Guild @relation("GuildSoundboard", fields: [guildId], references: [id], onDelete: Cascade)
  createdBy User  @relation("SoundboardCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// ── h-moderacao ──────────────────────────────────────────

// Ações que entram no registro de auditoria. Espelha `AuditAction` de
// `@streamz/shared`.
enum AuditAction {
  MEMBER_KICK
  MEMBER_BAN
  MEMBER_UNBAN
  MEMBER_TIMEOUT
  MEMBER_TIMEOUT_REMOVE
  MEMBER_ROLE_UPDATE
  CHANNEL_CREATE
  CHANNEL_UPDATE
  CHANNEL_DELETE
  ROLE_CREATE
  ROLE_UPDATE
  ROLE_DELETE
  INVITE_CREATE
  INVITE_REVOKE
  MESSAGE_DELETE
  MESSAGE_BULK_DELETE
  GUILD_UPDATE
  EMOJI_CREATE
  STICKER_CREATE
}

enum AuditTargetType {
  USER
  CHANNEL
  ROLE
  INVITE
  MESSAGE
  GUILD
  EMOJI
  STICKER
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  VIOLENCE
  NSFW
  SELF_HARM
  OTHER
}

// Registro de auditoria do servidor: quem fez o quê, com quem e por quê.
//
// O alvo é guardado por id **e** por nome (`targetName`), de propósito: canal
// apagado, convite revogado e conta removida deixam de existir, e o registro
// precisa continuar dizendo sobre o que ele fala. Por isso também não há chave
// estrangeira para o alvo — só para o servidor e para o ator.
model AuditLog {
  id         String           @id @default(cuid())
  guildId    String
  // null quando a conta do moderador foi apagada — o registro sobrevive.
  actorId    String?
  action     AuditAction
  targetId   String?
  targetType AuditTargetType?
  targetName String?
  // lista de { field, before, after } serializada; [] quando não se aplica.
  changes    Json             @default("[]")
  reason     String?
  createdAt  DateTime         @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  // a listagem é sempre "deste servidor, mais recentes primeiro"
  @@index([guildId, createdAt])
  @@index([guildId, action, createdAt])
  @@index([guildId, actorId, createdAt])
}

// Enquete: uma face de uma mensagem (1-a-1), não uma mensagem à parte. Assim
// ela herda canal, autor, permissão e histórico sem nenhum caminho novo.
model Poll {
  id        String    @id @default(cuid())
  messageId String    @unique
  question  String
  // texto das opções, na ordem; o voto referencia o índice.
  options   String[]
  multi     Boolean   @default(false)
  expiresAt DateTime?
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  votes   PollVote[]
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  userId      String
  optionIndex Int
  createdAt   DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // um voto por opção por pessoa; sem `multi` o service ainda garante um só
  @@unique([pollId, userId, optionIndex])
  @@index([pollId])
}

// Denúncia de mensagem, visível à moderação do servidor.
//
// `messageContent` é a cópia do texto no momento da denúncia: a mensagem pode
// ser apagada (inclusive *por causa* da denúncia) e o moderador ainda precisa
// ver o que foi denunciado.
model Report {
  id             String       @id @default(cuid())
  guildId        String
  channelId      String
  messageId      String?
  messageContent String?
  reporterId     String?
  // autor da mensagem denunciada, para agrupar por pessoa (sem FK: a conta
  // pode sumir e a denúncia continua valendo).
  targetId       String?
  reason         ReportReason
  details        String?
  resolved       Boolean      @default(false)
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reporter   User?    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User?    @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  // uma pessoa não denuncia a mesma mensagem duas vezes
  @@unique([messageId, reporterId])
  @@index([guildId, resolved, createdAt])
}

// ── i-conta ──────────────────────────────────────────────────
// Verificação de e-mail, redefinição de senha, 2FA e contas sociais.

// VERIFY: confirma o e-mail (24 h). RESET: redefine a senha (1 h).
enum EmailTokenType {
  VERIFY
  RESET
}

// Token de uso único enviado por e-mail. Guardamos só o hash: quem lê o banco
// não consegue verificar o e-mail nem trocar a senha de ninguém.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  // e-mail alvo no momento da emissão — o do usuário pode mudar antes do clique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// Código de recuperação do 2FA: 10 por ativação, hash no banco, uso único.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Conta social vinculada (Google/GitHub/Discord). O vínculo é por e-mail
// verificado: sem isso, quem controlasse um e-mail alheio no provedor entraria
// na conta de outro. `provider` é texto por ser um conjunto aberto de fato.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ── j-bots ───────────────────────────────────────────────────
//
// O registro de um bot. Ver `docs/BOTS-COMPATIVEIS-COM-O-DISCORD.md` §10.
// A instalação por servidor (`GuildApplication`), os comandos e as interações
// entram nas fases seguintes, com migrations próprias.

/// Uma "application" do portal: o registro do bot, dono e identidade.
model Application {
  id          String   @id @default(cuid())
  snowflake   BigInt   @unique @default(dbgenerated("streamz_snowflake()"))
  ownerId     String
  name        String
  description String?
  /// chave do ícone no storage; a URL é derivada na hora (padrão do repo)
  iconKey     String?
  /// aparece em "Descobrir aplicativos". Opt-in do dono, como o `discoverable`.
  publico     Boolean  @default(false)
  /// bitfield de `Permission` que a tela de instalação sugere por padrão
  permissoesPadrao Int  @default(0)
  /// o usuário-bot: um User com isBot = true, criado junto e sem senha utilizável
  botUserId   String   @unique
  createdAt   DateTime @default(now())

  owner   User       @relation("AppOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  botUser User       @relation("AppBot", fields: [botUserId], references: [id], onDelete: Cascade)
  tokens  BotToken[]

  @@index([ownerId])
  @@index([publico])
}

/// Token do bot. Guardamos só o SHA-256 — quem lê o banco não vira o bot.
/// Regenerar cria uma linha nova e revoga a antiga (nunca apaga: auditoria).
model BotToken {
  id            String    @id @default(cuid())
  applicationId String
  /// sha256 do token em hex. Não é argon2 de propósito: é lido a cada request.
  tokenHash     String    @unique
  /// Os 8 primeiros caracteres do token. Eles caem todos dentro da parte 1,
  /// que é o id do usuário-bot: identificam **o bot**, não o token, e não
  /// mudam quando se regenera. Servem para o dono reconhecer de quem é um
  /// token achado num arquivo de configuração; quem distingue um token do
  /// outro na tela é o `createdAt`.
  prefixo       String
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  revokedAt     DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}
