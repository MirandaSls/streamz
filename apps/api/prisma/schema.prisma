// Prisma schema — NewDisc
//
// Banco único: **PostgreSQL**, em dev e em produção. Não há mais variante
// SQLite — os enums (`UserStatus`, `ChannelType`, `MemberRole`) são garantidos
// pelo banco, e `packages/shared` expõe as mesmas unions para o contrato.
//
// Fluxo: `pnpm db:up` (Postgres do docker-compose) → `pnpm db:migrate`
// (migrate dev, cria/aplica migration) ou `pnpm db:deploy` em produção.
// `prisma db push` NÃO é o fluxo: toda mudança de modelo vira migration.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

// TEXT/VOICE: canal de servidor. DM/GROUP: conversa sem servidor (guildId null),
// cujo acesso é ser participante (ChannelMember). Ver docs/adr/0001.
enum ChannelType {
  TEXT
  VOICE
  DM
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  // nome de exibição (o Discord separa "display name" de "username")
  displayName  String?
  avatarUrl    String?
  // chave do objeto do avatar no storage; a URL pública é derivada na hora
  avatarKey    String?
  // presença efetiva, mantida pelo gateway (ONLINE/OFFLINE conforme conexões)
  status       UserStatus  @default(OFFLINE)
  // status escolhido pelo usuário (Ausente, Não perturbe, Invisível=OFFLINE);
  // null = automático. Só vale enquanto ele está conectado.
  manualStatus UserStatus?
  createdAt    DateTime    @default(now())

  ownedGuilds   Guild[]         @relation("GuildOwner")
  memberships   GuildMember[]
  messages      Message[]
  reactions     Reaction[]
  invites       Invite[]        @relation("InviteCreator")
  bans          Ban[]           @relation("BannedUser")
  ownedChannels Channel[]       @relation("ChannelOwner")
  refreshTokens RefreshToken[]
  channelAccess ChannelMember[]
  attachments   Attachment[]    @relation("AttachmentUploader")
  readStates    ReadState[]

  // ── h-moderacao ──
  auditLogs       AuditLog[] @relation("AuditActor")
  pollVotes       PollVote[]
  reportsMade     Report[]   @relation("ReportReporter")
  reportsResolved Report[]   @relation("ReportResolver")
}

// Até onde cada usuário leu cada canal. É o que decide "não lido" e o badge
// de menções: mensagem com createdAt > lastReadAt (e que não é do próprio
// usuário) conta como nova. Sem linha = nunca abriu o canal.
model ReadState {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
}

// Um registro por refresh token emitido. Rotação: a cada /auth/refresh o token
// apresentado é marcado como revogado e um novo é emitido. Logout revoga.
// Guardamos só o hash do jti — nunca o token em si.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Guild {
  id      String  @id @default(cuid())
  name    String
  iconUrl String?
  ownerId String
  owner   User    @relation("GuildOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  members  GuildMember[]
  channels Channel[]
  invites  Invite[]
  bans     Ban[]

  // ── h-moderacao ──
  // Canal onde entram as mensagens "X entrou no servidor"; null = desligado.
  systemChannelId    String?
  // Canal de regras. Quando existe, postar exige aceite (GuildMember.acceptedRulesAt).
  rulesChannelId     String?
  welcomeDescription String?
  // Canais em destaque da tela de boas-vindas, na ordem escolhida.
  welcomeChannelIds  String[]   @default([])
  // Aparece em "Descobrir" (GET /discover).
  discoverable       Boolean    @default(false)
  description        String?
  auditLogs          AuditLog[]
  reports            Report[]
}

model Ban {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  bannedById String
  reason     String?
  createdAt  DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  guildId   String
  creatorId String
  uses      Int       @default(0)
  maxUses   Int?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  guild   Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator User  @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  // ── h-moderacao ──
  // Convite temporário: o convidado sai do servidor ao desconectar.
  temporary Boolean  @default(false)
  // Canal para onde o convite leva; null = canal de sistema ou o primeiro.
  channelId String?
  channel   Channel? @relation("InviteChannel", fields: [channelId], references: [id], onDelete: SetNull)

  @@index([guildId])
}

model GuildMember {
  id      String     @id @default(cuid())
  userId  String
  guildId String
  role    MemberRole @default(MEMBER)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  // ── h-moderacao ──
  // Fim do castigo. Data no passado = sem castigo (o histórico não é apagado).
  timeoutUntil    DateTime?
  // Quando aceitou as regras do servidor; null = ainda não aceitou.
  acceptedRulesAt DateTime?
  // Quando viu a tela de boas-vindas; null = mostrar ao abrir o servidor.
  welcomeSeenAt   DateTime?

  @@unique([userId, guildId])
  @@index([guildId])
}

// Um canal é qualquer lugar onde mensagens vivem — canal de servidor (TEXT/VOICE)
// ou conversa direta (DM/GROUP). Uma tabela só para que toda feature de mensagem
// (reação, anexo, thread, busca) valha nos dois casos por construção (ADR-0001).
model Channel {
  id        String      @id @default(cuid())
  // null em DM/GROUP: a conversa não pertence a servidor nenhum. Toda query de
  // servidor precisa partir de um guildId concreto — nunca "todos os canais".
  guildId   String?
  // null em DM (o título é derivado dos participantes); opcional em GROUP.
  name      String?
  type      ChannelType @default(TEXT)
  position  Int         @default(0)
  private   Boolean     @default(false) // só OWNER/ADMIN e a allowlist enxergam
  readOnly  Boolean     @default(false) // só OWNER/ADMIN postam; todos leem
  // criador do grupo; null em DM e em canal de servidor.
  ownerId   String?
  // chave canônica "a:b" (ids ordenados) só em DM 1-a-1 — garante 1 canal por
  // dupla via upsert atômico. NULLs múltiplos são permitidos no Postgres.
  pairKey   String?     @unique
  createdAt DateTime    @default(now())

  guild      Guild?          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  owner      User?           @relation("ChannelOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  messages   Message[]
  members    ChannelMember[]
  readStates ReadState[]

  // ── h-moderacao ──
  channelInvites Invite[] @relation("InviteChannel")
  reports        Report[]

  @@index([guildId])
}

// Duas leituras, mesma tabela: em canal de servidor privado é a allowlist de
// quem enxerga (além de OWNER/ADMIN, sempre com acesso); em DM/GROUP é a lista
// de participantes. Nos dois casos responde "este usuário tem acesso a este
// canal?".
model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId]) // "minhas conversas"
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions   Reaction[]
  attachments Attachment[]

  // thread: uma mensagem-raiz (parentId null) agrupa respostas
  parent  Message?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Message[] @relation("MessageThread")

  // ── h-moderacao ──
  // Mensagem escrita pelo próprio servidor (entrada no servidor, aviso da
  // moderação na DM). null = mensagem comum, de gente.
  systemType MessageSystemType?
  poll       Poll?
  reports    Report[]

  @@index([channelId, parentId, createdAt])
  @@index([parentId])
}

// Arquivo enviado ao storage (R2). Criado no upload (messageId null) e
// vinculado a uma mensagem no envio. Órfãos (nunca vinculados) são apagados
// pela faxina diária do MaintenanceService, no bucket e aqui. O objeto no
// bucket vive na chave `key`.
model Attachment {
  id          String   @id @default(cuid())
  messageId   String?
  uploaderId  String
  key         String   @unique
  filename    String
  contentType String
  size        Int
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User     @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId])
}

model Reaction {
  id        String @id @default(cuid())
  messageId String
  userId    String
  emoji     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ── h-moderacao ──────────────────────────────────────────

// Tipo de mensagem escrita pelo servidor. Espelha `MessageSystemType` de
// `@newdisc/shared` (equivalência travada em common/enums.ts).
enum MessageSystemType {
  SYSTEM_JOIN
  SYSTEM_MOD_NOTICE
}

// Ações que entram no registro de auditoria. Espelha `AuditAction` de
// `@newdisc/shared`.
enum AuditAction {
  MEMBER_KICK
  MEMBER_BAN
  MEMBER_UNBAN
  MEMBER_TIMEOUT
  MEMBER_TIMEOUT_REMOVE
  MEMBER_ROLE_UPDATE
  CHANNEL_CREATE
  CHANNEL_UPDATE
  CHANNEL_DELETE
  ROLE_CREATE
  ROLE_UPDATE
  ROLE_DELETE
  INVITE_CREATE
  INVITE_REVOKE
  MESSAGE_DELETE
  MESSAGE_BULK_DELETE
  GUILD_UPDATE
  EMOJI_CREATE
  STICKER_CREATE
}

enum AuditTargetType {
  USER
  CHANNEL
  ROLE
  INVITE
  MESSAGE
  GUILD
  EMOJI
  STICKER
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  VIOLENCE
  NSFW
  SELF_HARM
  OTHER
}

// Registro de auditoria do servidor: quem fez o quê, com quem e por quê.
//
// O alvo é guardado por id **e** por nome (`targetName`), de propósito: canal
// apagado, convite revogado e conta removida deixam de existir, e o registro
// precisa continuar dizendo sobre o que ele fala. Por isso também não há chave
// estrangeira para o alvo — só para o servidor e para o ator.
model AuditLog {
  id         String           @id @default(cuid())
  guildId    String
  // null quando a conta do moderador foi apagada — o registro sobrevive.
  actorId    String?
  action     AuditAction
  targetId   String?
  targetType AuditTargetType?
  targetName String?
  // lista de { field, before, after } serializada; [] quando não se aplica.
  changes    Json             @default("[]")
  reason     String?
  createdAt  DateTime         @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  // a listagem é sempre "deste servidor, mais recentes primeiro"
  @@index([guildId, createdAt])
  @@index([guildId, action, createdAt])
  @@index([guildId, actorId, createdAt])
}

// Enquete: uma face de uma mensagem (1-a-1), não uma mensagem à parte. Assim
// ela herda canal, autor, permissão e histórico sem nenhum caminho novo.
model Poll {
  id        String    @id @default(cuid())
  messageId String    @unique
  question  String
  // texto das opções, na ordem; o voto referencia o índice.
  options   String[]
  multi     Boolean   @default(false)
  expiresAt DateTime?
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  votes   PollVote[]
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  userId      String
  optionIndex Int
  createdAt   DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // um voto por opção por pessoa; sem `multi` o service ainda garante um só
  @@unique([pollId, userId, optionIndex])
  @@index([pollId])
}

// Denúncia de mensagem, visível à moderação do servidor.
//
// `messageContent` é a cópia do texto no momento da denúncia: a mensagem pode
// ser apagada (inclusive *por causa* da denúncia) e o moderador ainda precisa
// ver o que foi denunciado.
model Report {
  id             String       @id @default(cuid())
  guildId        String
  channelId      String
  messageId      String?
  messageContent String?
  reporterId     String?
  // autor da mensagem denunciada, para agrupar por pessoa (sem FK: a conta
  // pode sumir e a denúncia continua valendo).
  targetId       String?
  reason         ReportReason
  details        String?
  resolved       Boolean      @default(false)
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reporter   User?    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User?    @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  // uma pessoa não denuncia a mesma mensagem duas vezes
  @@unique([messageId, reporterId])
  @@index([guildId, resolved, createdAt])
}
