// Prisma schema — NewDisc
//
// Banco único: **PostgreSQL**, em dev e em produção. Não há mais variante
// SQLite — os enums (`UserStatus`, `ChannelType`, `MemberRole`) são garantidos
// pelo banco, e `packages/shared` expõe as mesmas unions para o contrato.
//
// Fluxo: `pnpm db:up` (Postgres do docker-compose) → `pnpm db:migrate`
// (migrate dev, cria/aplica migration) ou `pnpm db:deploy` em produção.
// `prisma db push` NÃO é o fluxo: toda mudança de modelo vira migration.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

// TEXT/VOICE: canal de servidor. DM/GROUP: conversa sem servidor (guildId null),
// cujo acesso é ser participante (ChannelMember). Ver docs/adr/0001.
enum ChannelType {
  TEXT
  VOICE
  DM
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  // nome de exibição (o Discord separa "display name" de "username")
  displayName  String?
  avatarUrl    String?
  // chave do objeto do avatar no storage; a URL pública é derivada na hora
  avatarKey    String?
  // presença efetiva, mantida pelo gateway (ONLINE/OFFLINE conforme conexões)
  status       UserStatus @default(OFFLINE)
  // status escolhido pelo usuário (Ausente, Não perturbe, Invisível=OFFLINE);
  // null = automático. Só vale enquanto ele está conectado.
  manualStatus UserStatus?
  createdAt    DateTime   @default(now())

  ownedGuilds      Guild[]         @relation("GuildOwner")
  memberships      GuildMember[]
  messages         Message[]
  reactions        Reaction[]
  invites          Invite[]        @relation("InviteCreator")
  bans             Ban[]           @relation("BannedUser")
  ownedChannels    Channel[]       @relation("ChannelOwner")
  refreshTokens    RefreshToken[]
  channelAccess    ChannelMember[]
  attachments      Attachment[]    @relation("AttachmentUploader")
  readStates       ReadState[]

  // ── i-conta ── e-mail, 2FA, bloqueio por força bruta e fim de vida da conta
  // nullable porque contas criadas antes de o e-mail existir seguem válidas
  email           String?   @unique
  emailVerifiedAt DateTime?
  // data de nascimento (Discord pede no registro); só guardamos o dia
  birthDate       DateTime?
  // segredo TOTP em base32; só vira 2FA de fato quando mfaEnabledAt existe
  mfaSecret       String?
  mfaEnabledAt    DateTime?
  // bloqueio progressivo por conta: 5 falhas seguidas trancam por 15 min
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  // conta desativada pelo dono: bloqueia o login até ele reativar entrando
  disabledAt      DateTime?
  // conta excluída: anonimizada, sem volta. As mensagens ficam (como no Discord)
  deletedAt       DateTime?

  emailTokens   EmailToken[]
  recoveryCodes MfaRecoveryCode[]
  oauthAccounts OAuthAccount[]
}

// Até onde cada usuário leu cada canal. É o que decide "não lido" e o badge
// de menções: mensagem com createdAt > lastReadAt (e que não é do próprio
// usuário) conta como nova. Sem linha = nunca abriu o canal.
model ReadState {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
}

// Um registro por refresh token emitido. Rotação: a cada /auth/refresh o token
// apresentado é marcado como revogado e um novo é emitido. Logout revoga.
// Guardamos só o hash do jti — nunca o token em si.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // ── i-conta ── um refresh token vivo *é* uma sessão na tela "Dispositivos";
  // sem estes campos ela não teria o que mostrar além da data.
  userAgent  String?
  ip         String?
  lastUsedAt DateTime?
}

model Guild {
  id      String  @id @default(cuid())
  name    String
  iconUrl String?
  ownerId String
  owner   User    @relation("GuildOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  members  GuildMember[]
  channels Channel[]
  invites  Invite[]
  bans     Ban[]
}

model Ban {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  bannedById String
  reason     String?
  createdAt  DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  guildId   String
  creatorId String
  uses      Int       @default(0)
  maxUses   Int?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  guild   Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator User  @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model GuildMember {
  id      String     @id @default(cuid())
  userId  String
  guildId String
  role    MemberRole @default(MEMBER)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([userId, guildId])
  @@index([guildId])
}

// Um canal é qualquer lugar onde mensagens vivem — canal de servidor (TEXT/VOICE)
// ou conversa direta (DM/GROUP). Uma tabela só para que toda feature de mensagem
// (reação, anexo, thread, busca) valha nos dois casos por construção (ADR-0001).
model Channel {
  id        String      @id @default(cuid())
  // null em DM/GROUP: a conversa não pertence a servidor nenhum. Toda query de
  // servidor precisa partir de um guildId concreto — nunca "todos os canais".
  guildId   String?
  // null em DM (o título é derivado dos participantes); opcional em GROUP.
  name      String?
  type      ChannelType @default(TEXT)
  position  Int         @default(0)
  private   Boolean     @default(false) // só OWNER/ADMIN e a allowlist enxergam
  readOnly  Boolean     @default(false) // só OWNER/ADMIN postam; todos leem
  // criador do grupo; null em DM e em canal de servidor.
  ownerId   String?
  // chave canônica "a:b" (ids ordenados) só em DM 1-a-1 — garante 1 canal por
  // dupla via upsert atômico. NULLs múltiplos são permitidos no Postgres.
  pairKey   String?     @unique
  createdAt DateTime    @default(now())

  guild    Guild?          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  owner    User?           @relation("ChannelOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  messages   Message[]
  members    ChannelMember[]
  readStates ReadState[]

  @@index([guildId])
}

// Duas leituras, mesma tabela: em canal de servidor privado é a allowlist de
// quem enxerga (além de OWNER/ADMIN, sempre com acesso); em DM/GROUP é a lista
// de participantes. Nos dois casos responde "este usuário tem acesso a este
// canal?".
model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId]) // "minhas conversas"
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions   Reaction[]
  attachments Attachment[]

  // thread: uma mensagem-raiz (parentId null) agrupa respostas
  parent  Message?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Message[] @relation("MessageThread")

  @@index([channelId, parentId, createdAt])
  @@index([parentId])
}

// Arquivo enviado ao storage (R2). Criado no upload (messageId null) e
// vinculado a uma mensagem no envio. Órfãos (nunca vinculados) são apagados
// pela faxina diária do MaintenanceService, no bucket e aqui. O objeto no
// bucket vive na chave `key`.
model Attachment {
  id          String   @id @default(cuid())
  messageId   String?
  uploaderId  String
  key         String   @unique
  filename    String
  contentType String
  size        Int
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User     @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId])
}

model Reaction {
  id        String @id @default(cuid())
  messageId String
  userId    String
  emoji     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ── i-conta ──────────────────────────────────────────────────
// Verificação de e-mail, redefinição de senha, 2FA e contas sociais.

// VERIFY: confirma o e-mail (24 h). RESET: redefine a senha (1 h).
enum EmailTokenType {
  VERIFY
  RESET
}

// Token de uso único enviado por e-mail. Guardamos só o hash: quem lê o banco
// não consegue verificar o e-mail nem trocar a senha de ninguém.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  // e-mail alvo no momento da emissão — o do usuário pode mudar antes do clique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// Código de recuperação do 2FA: 10 por ativação, hash no banco, uso único.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Conta social vinculada (Google/GitHub/Discord). O vínculo é por e-mail
// verificado: sem isso, quem controlasse um e-mail alheio no provedor entraria
// na conta de outro. `provider` é texto por ser um conjunto aberto de fato.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}
