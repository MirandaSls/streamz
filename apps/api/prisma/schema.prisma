// Prisma schema — NewDisc
//
// Banco único: **PostgreSQL**, em dev e em produção. Não há mais variante
// SQLite — os enums (`UserStatus`, `ChannelType`, `MemberRole`) são garantidos
// pelo banco, e `packages/shared` expõe as mesmas unions para o contrato.
//
// Fluxo: `pnpm db:up` (Postgres do docker-compose) → `pnpm db:migrate`
// (migrate dev, cria/aplica migration) ou `pnpm db:deploy` em produção.
// `prisma db push` NÃO é o fluxo: toda mudança de modelo vira migration.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

// TEXT/VOICE: canal de servidor. DM/GROUP: conversa sem servidor (guildId null),
// cujo acesso é ser participante (ChannelMember). Ver docs/adr/0001.
enum ChannelType {
  TEXT
  VOICE
  DM
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id                    String      @id @default(cuid())
  username              String      @unique
  passwordHash          String
  // nome de exibição (o Discord separa "display name" de "username")
  displayName           String?
  avatarUrl             String?
  // chave do objeto do avatar no storage; a URL pública é derivada na hora
  avatarKey             String?
  // presença efetiva, mantida pelo gateway (ONLINE/OFFLINE conforme conexões)
  status                UserStatus  @default(OFFLINE)
  // status escolhido pelo usuário (Ausente, Não perturbe, Invisível=OFFLINE);
  // null = automático. Só vale enquanto ele está conectado.
  manualStatus          UserStatus?
  createdAt             DateTime    @default(now())
  // ── d-social ──
  // Status personalizado: texto + emoji + quando deixa de valer (null = nunca).
  // A faxina do MaintenanceService zera os vencidos; a leitura também trata o
  // vencido como ausente, para não depender do horário do job.
  customStatusText      String?
  customStatusEmoji     String?
  customStatusExpiresAt DateTime?
  // Perfil rico: "sobre mim", pronomes e a faixa do cartão (cor ou imagem).
  aboutMe               String?
  pronouns              String?
  bannerColor           String?
  bannerKey             String?
  // Última desconexão — "visto por último" no perfil. O gateway grava no
  // disconnect; enquanto o usuário está online o valor é o da sessão anterior.
  lastSeenAt            DateTime?

  ownedGuilds         Guild[]         @relation("GuildOwner")
  memberships         GuildMember[]
  messages            Message[]
  reactions           Reaction[]
  invites             Invite[]        @relation("InviteCreator")
  bans                Ban[]           @relation("BannedUser")
  ownedChannels       Channel[]       @relation("ChannelOwner")
  refreshTokens       RefreshToken[]
  channelAccess       ChannelMember[]
  attachments         Attachment[]    @relation("AttachmentUploader")
  readStates          ReadState[]
  // ── d-social ──
  friendshipsSent     Friendship[]    @relation("FriendshipRequester")
  friendshipsReceived Friendship[]    @relation("FriendshipAddressee")
  blocksMade          Block[]         @relation("Blocker")
  blocksReceived      Block[]         @relation("Blocked")
  hiddenChannels      DMHidden[]
}

// Até onde cada usuário leu cada canal. É o que decide "não lido" e o badge
// de menções: mensagem com createdAt > lastReadAt (e que não é do próprio
// usuário) conta como nova. Sem linha = nunca abriu o canal.
model ReadState {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
}

// Um registro por refresh token emitido. Rotação: a cada /auth/refresh o token
// apresentado é marcado como revogado e um novo é emitido. Logout revoga.
// Guardamos só o hash do jti — nunca o token em si.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Guild {
  id      String  @id @default(cuid())
  name    String
  iconUrl String?
  ownerId String
  owner   User    @relation("GuildOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  members  GuildMember[]
  channels Channel[]
  invites  Invite[]
  bans     Ban[]
}

model Ban {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  bannedById String
  reason     String?
  createdAt  DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  guildId   String
  creatorId String
  uses      Int       @default(0)
  maxUses   Int?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  guild   Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator User  @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

model GuildMember {
  id      String     @id @default(cuid())
  userId  String
  guildId String
  role    MemberRole @default(MEMBER)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([userId, guildId])
  @@index([guildId])
}

// Um canal é qualquer lugar onde mensagens vivem — canal de servidor (TEXT/VOICE)
// ou conversa direta (DM/GROUP). Uma tabela só para que toda feature de mensagem
// (reação, anexo, thread, busca) valha nos dois casos por construção (ADR-0001).
model Channel {
  id        String      @id @default(cuid())
  // null em DM/GROUP: a conversa não pertence a servidor nenhum. Toda query de
  // servidor precisa partir de um guildId concreto — nunca "todos os canais".
  guildId   String?
  // null em DM (o título é derivado dos participantes); opcional em GROUP.
  name      String?
  type      ChannelType @default(TEXT)
  position  Int         @default(0)
  private   Boolean     @default(false) // só OWNER/ADMIN e a allowlist enxergam
  readOnly  Boolean     @default(false) // só OWNER/ADMIN postam; todos leem
  // criador do grupo; null em DM e em canal de servidor.
  ownerId   String?
  // chave canônica "a:b" (ids ordenados) só em DM 1-a-1 — garante 1 canal por
  // dupla via upsert atômico. NULLs múltiplos são permitidos no Postgres.
  pairKey   String?     @unique
  createdAt DateTime    @default(now())
  // ── d-social ── chave do ícone do grupo no storage (null em DM 1-a-1)
  iconKey   String?

  guild      Guild?          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  owner      User?           @relation("ChannelOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  messages   Message[]
  members    ChannelMember[]
  readStates ReadState[]
  // ── d-social ──
  hiddenBy   DMHidden[]

  @@index([guildId])
}

// Duas leituras, mesma tabela: em canal de servidor privado é a allowlist de
// quem enxerga (além de OWNER/ADMIN, sempre com acesso); em DM/GROUP é a lista
// de participantes. Nos dois casos responde "este usuário tem acesso a este
// canal?".
model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId]) // "minhas conversas"
}

model Message {
  id        String      @id @default(cuid())
  channelId String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime    @default(now())
  editedAt  DateTime?
  // ── d-social ── DEFAULT = escrita por alguém; SYSTEM_* = evento do grupo de DM
  type      MessageType @default(DEFAULT)

  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions   Reaction[]
  attachments Attachment[]

  // thread: uma mensagem-raiz (parentId null) agrupa respostas
  parent  Message?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Message[] @relation("MessageThread")

  @@index([channelId, parentId, createdAt])
  @@index([parentId])
}

// Arquivo enviado ao storage (R2). Criado no upload (messageId null) e
// vinculado a uma mensagem no envio. Órfãos (nunca vinculados) são apagados
// pela faxina diária do MaintenanceService, no bucket e aqui. O objeto no
// bucket vive na chave `key`.
model Attachment {
  id          String   @id @default(cuid())
  messageId   String?
  uploaderId  String
  key         String   @unique
  filename    String
  contentType String
  size        Int
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User     @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId])
}

model Reaction {
  id        String @id @default(cuid())
  messageId String
  userId    String
  emoji     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ── d-social ──────────────────────────────────────────────────

// Tipo de mensagem. As SYSTEM_* são eventos do grupo de DM (entrou, saiu,
// renomeou) renderizados como uma linha discreta, sem avatar nem ações; o
// autor é quem fez a ação e o `content` guarda o alvo ou o valor novo.
enum MessageType {
  DEFAULT
  SYSTEM_MEMBER_ADDED
  SYSTEM_MEMBER_REMOVED
  SYSTEM_MEMBER_LEFT
  SYSTEM_GROUP_RENAMED
  SYSTEM_GROUP_ICON
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Amizade e pedido de amizade na mesma linha: PENDING é o pedido de
// `requester` para `addressee`, ACCEPTED é a amizade (que não tem direção).
// Uma linha só evita o estado impossível "A é amigo de B mas B não é de A".
// A unicidade do par é garantida por `pairKey` ("menor:maior"), porque o
// @@unique([requesterId, addresseeId]) sozinho deixaria os dois lados pedirem.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  pairKey     String           @unique
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([addresseeId])
}

// Bloqueio: direcional (A bloqueia B sem que B saiba). Bloquear derruba a
// amizade e o pedido pendente; o bloqueado não abre DM nem manda pedido.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Conversa "fechada" por um usuário: some da lista dele até chegar mensagem
// nova. Guardar o instante (e não um booleano) é o que faz a conversa
// reaparecer sozinha — a lista compara `hiddenAt` com a última mensagem, sem
// depender de ninguém apagar a linha no envio.
model DMHidden {
  userId    String
  channelId String
  hiddenAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
}
